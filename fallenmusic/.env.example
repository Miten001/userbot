# ============================================================
#  FALLEN MUSIC BOT — environment template
#  Copy to `.env` for local runs. On Render, set these as
#  service Environment variables instead — never commit secrets.
# ============================================================

# --- REQUIRED ------------------------------------------------

# https://my.telegram.org  ->  API development tools
API_ID=
API_HASH=

# @BotFather  ->  /newbot
BOT_TOKEN=

# Assistant (userbot) Pyrogram v2 string session.
# Generate with:  python3 -m FallenMusic.gen  (see README)
SESSION=

# Your numeric Telegram ID (@userinfobot). Gets sudo automatically.
OWNER_ID=

# --- OPTIONAL ------------------------------------------------

# Extra sudo users, space separated. Leave empty unless you need them.
# NOTE: sudo includes /eval, which runs arbitrary Python on your server.
SUDO_USERS=

# Max track length in minutes that /play accepts.
DURATION_LIMIT=90

# Public t.me links shown by /start
SUPPORT_CHAT=https://t.me/DevilsHeavenMF
SUPPORT_CHANNEL=https://t.me/FallenAssociation

# Seconds between reconnect attempts when Telegram is unreachable.
RETRY_SECONDS=30

# YouTube player clients to try, in order, when YouTube refuses a request
# ("Failed to extract any player response").  This is common on datacentre IPs
# like Render's.  The list is tried after yt-dlp's own defaults.
# Valid names (yt-dlp 2026.10.21): android, android_vr, ios, mweb, tv,
# tv_downgraded, tv_samsung, tv_simply, visionos, web, web_creator,
# web_embedded, web_music, web_safari
YTDLP_CLIENTS=web_embedded,tv_downgraded,tv_simply,mweb,android,tv

# Port for the health endpoint. Render injects this automatically.
PORT=10000

# --- LEAVE AT 0 ----------------------------------------------

# "1" grants the upstream author sudo on YOUR bot (incl. /eval). Keep 0.
ADD_UPSTREAM_SUDO=0

# "1" makes your assistant join the author's two chats on every boot. Keep 0.
JOIN_UPSTREAM_CHATS=0
