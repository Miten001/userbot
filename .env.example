# ApexFunded backend env vars
# Copy to .env.local for dev, or add in Vercel project settings for production.

# === Public site URL (used for payment redirects) ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Supabase (https://supabase.com -> create project -> Settings -> API) ===
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Payments: UPI via Razorpay (https://dashboard.razorpay.com) ===
# Test mode keys for now. Settings -> API Keys. Webhook secret from
# Settings -> Webhooks (event: payment_link.paid -> /api/webhooks/razorpay).
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plans are priced in USD; Razorpay charges INR. Conversion rate (USD->INR):
USD_TO_INR=84

# === Payments: Crypto via NOWPayments (https://nowpayments.io) ===
# API key creates invoices; IPN secret verifies callbacks
# (Store Settings -> set IPN callback URL to /api/webhooks/nowpayments).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# === MT5 / MetaApi (https://metaapi.cloud) ===
# Leave empty to use the built-in MOCK provider (fake account numbers).
# When you sign up at metaapi.cloud, paste your API token here.
METAAPI_TOKEN=
METAAPI_REGION=new-york

# Optional: comma-separated list of admin user IDs (Supabase user.id) who can see /admin
ADMIN_USER_IDS=

# === Cron / risk-engine sync ===
# Secret used to authorize the /api/sync endpoint (equity refresh + drawdown
# enforcement). Vercel Cron automatically sends this as a Bearer token.
# Generate one with:  openssl rand -hex 32
# Leave empty in local dev — an admin session can also trigger /api/sync.
CRON_SECRET=

# === Email notifications (optional) ===
# Resend API key for transactional emails (account ready, funded, breached,
# payout updates). Leave empty to disable — the app no-ops gracefully.
# Get one at https://resend.com
RESEND_API_KEY=
# From address (must be a verified Resend domain in production)
EMAIL_FROM="ApexFunded <onboarding@resend.dev>"

# === Google OAuth (optional) ===
# Set to "true" to show the "Continue with Google" button on login/signup.
# You must also enable the Google provider in your Supabase Auth settings.
NEXT_PUBLIC_GOOGLE_AUTH=
